# Site URL (defaults to https://bikechala.com)
NEXT_PUBLIC_SITE_URL=https://bikechala.com

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Allow comparison pages (/compare/a-vs-b) to be indexed by search engines.
# Set to 'true' 3-4 weeks after launch once model pages are indexed.
INDEX_COMPARE=false
